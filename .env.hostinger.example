APP_NAME="Edlink School Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
EDLINK_ROOT_DOMAIN=your-domain.example
APP_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_HOSTINGER_DATABASE
DB_USERNAME=REPLACE_WITH_HOSTINGER_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SANCTUM_EXPIRATION=10080
QUEUE_CONNECTION=database
CACHE_STORE=database

BACKUP_RETENTION_DAYS=30
MYSQLDUMP_BINARY=mysqldump
BACKUP_OFFSITE_REQUIRED=true
BACKUP_OFFSITE_DISK=s3
BACKUP_OFFSITE_PREFIX=edlink-production
SYSTEM_ALERT_WEBHOOK_URL=REPLACE_WITH_EXTERNAL_MONITORING_WEBHOOK

AWS_ACCESS_KEY_ID=REPLACE_WITH_OFFSITE_STORAGE_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_OFFSITE_STORAGE_SECRET
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=REPLACE_WITH_OFFSITE_BACKUP_BUCKET
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_SERVER_SIDE_ENCRYPTION=AES256

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.example
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=noreply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=your-domain.example

FINANCE_APPROVAL_THRESHOLD=1000000
PRIVACY_RETENTION_DAYS=2555
OTP_FORCE=false
LEGAL_POLICY_VERSION=2026-10-18
LEGAL_CONTACT_EMAIL=support@edlink.space

VITE_APP_NAME="${APP_NAME}"
