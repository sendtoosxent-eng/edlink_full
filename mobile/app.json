{
  "expo": {
    "name": "Edlink",
    "slug": "edlink-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/Edlink 1logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "barStyle": "dark-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#231E34",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.edlink.school",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Edlink to use Face ID for secure quick login."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#efb000",
          "image": "./assets/splash-icon.png",
          "dark": {
            "backgroundColor": "#efb000",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/f35e35a0-b8bb-48a9-90ec-ed078f75c1da"
    },
    "extra": {
      "eas": {
        "projectId": "f35e35a0-b8bb-48a9-90ec-ed078f75c1da"
      }
    }
  }
}
