  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --localhost --android",
    "android:lan": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:login": "npx eas-cli@latest login",
    "updates:configure": "npx eas-cli@latest update:configure",
    "build:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli@latest build --platform ios --profile preview",
    "build:production": "npx eas-cli@latest build --platform android --profile production",
    "build:production:ios": "npx eas-cli@latest build --platform ios --profile production",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview",
    "update:production": "npx eas-cli@latest update --channel production --environment production"
