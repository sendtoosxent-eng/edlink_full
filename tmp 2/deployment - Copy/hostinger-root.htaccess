<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep certificate validation available to Hostinger/Let's Encrypt.
    RewriteRule ^\.well-known/ - [L]

    # Hostinger shared hosting serves public_html. Laravel's front controller
    # lives in public/, so forward every request there without exposing the
    # application directories directly.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
